  },
  "feature_selection": {
    "selected_features": [
      "mean",
      "std",
      "min",
      "max",
      "median",
      "sum",
      "variance",
      "skewness",
      "kurtosis",
      "abs_energy",
      "root_mean_square",
      "mean_abs_change",
      "mean_change",
      "count_above_mean",
      "count_below_mean",
      "first_location_of_maximum",
      "first_location_of_minimum",
      "last_location_of_maximum",
      "last_location_of_minimum",
      "percentage_of_reoccurring_values",
      "sum_of_reoccurring_values",
      "abs_sum_of_changes",
      "range",
      "interquartile_range",
      "mean_second_derivative",
      "rms",
      "peak_to_peak",
      "crest_factor",
      "shape_factor",
      "impulse_factor",
      "margin_factor",
      "zero_crossing_rate",
      "autocorr_lag1",
      "autocorr_lag5",
      "binned_entropy",
      "spectral_centroid",
      "spectral_bandwidth",
