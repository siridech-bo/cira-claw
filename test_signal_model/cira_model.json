{
  "input_type": "signal",
  "normalization": {
    "sensor_columns": [
      "ch0"
    ],
    "channel_min": [
      -10.0
    ],
    "channel_max": [
      10.0
    ]
  },
  "windowing": {
    "window_size": 128,
    "stride": 64
  },
  "feature_extraction": {
    "num_features": 46,
    "method": "canonical_46",
